						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "Adding & Removing Elements"
								}
							]
						},
						{
							"type": "paragraph"
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "document.createElement(\"tag\")"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "element.appendChild(newElement)"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "element.remove()"
