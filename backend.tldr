			"id": "shape:NJT6t_35QLBpA4wr1HVbT",
			"typeName": "shape",
			"parentId": "page:page",
			"index": "aLImn",
			"type": "text",
			"props": {
				"color": "light-blue",
				"size": "xl",
				"w": 8,
				"font": "draw",
				"textAlign": "start",
				"autoSize": true,
				"scale": 2.415738194493302,
				"richText": {
					"type": "doc",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "JavaScript was invented by Brendan Eich in 1995. It"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "was developed for Netscape 2, and became the"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "ECMA-262 standard in 1997. After Netscape"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "handed JavaScript over to ECMA, the Mozilla"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "foundation continued to develop JavaScript for the"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "Firefox browser"
								}
							]
						}
					]
				}
			}
		},
